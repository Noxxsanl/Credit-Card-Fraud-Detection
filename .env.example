# Sao chép thành .env rồi chỉnh (docs/10 §2.2). .env không commit.

# Cổng PostgreSQL trên máy chủ. Đổi thành 5433 nếu máy đã có PostgreSQL khác chiếm 5432.
POSTGRES_HOST_PORT=5432

# Khi chạy API trực tiếp trên máy (uvicorn). Trong Docker Compose, dịch vụ api dùng host db.
DATABASE_URL=postgresql+psycopg://fraud:fraud@localhost:5432/fraud

# Cơ sở dữ liệu dùng một lần cho pytest — tests/conftest.py tự tạo rồi xoá (docs/08 §1.1)
TEST_DATABASE_URL=postgresql+psycopg://fraud:fraud@localhost:5432/fraud_test
