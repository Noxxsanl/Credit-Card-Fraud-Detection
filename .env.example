# Sao chép thành .env rồi chỉnh (docs/10 §2.2). .env không commit.
# Chỉ chạy `docker compose up` thì KHÔNG cần tệp này: mọi biến dưới đây đều có giá trị mặc định.

# Cổng PostgreSQL trên máy chủ. Đổi thành 5433 nếu máy đã có PostgreSQL khác chiếm 5432.
POSTGRES_HOST_PORT=5432

# Cổng API và giao diện trên máy chủ (docker compose up). Đổi khi cổng đã bị chiếm.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Địa chỉ mà ba cổng trên mở ra. Mặc định 127.0.0.1: chỉ chính máy này vào được — API không có
# đăng nhập, ai vào được là đổi được ngưỡng. Trình chiếu từ máy khác: 0.0.0.0 (và đổi mật khẩu dưới).
BIND_ADDRESS=127.0.0.1

# Mật khẩu PostgreSQL của dịch vụ db. Đổi thì sửa luôn DATABASE_URL và TEST_DATABASE_URL bên dưới.
# Chỉ có tác dụng khi volume pgdata được tạo mới (docker compose down -v) — initdb đặt mật khẩu một lần.
POSTGRES_PASSWORD=fraud

# Bản giao diện mà dịch vụ web đóng gói: frontend (Next.js, mặc định) hoặc web (HTML + Alpine.js).
# Đổi xong phải build lại: docker compose up --build
WEB_UI=frontend

# Khi chạy API trực tiếp trên máy (uvicorn). Trong Docker Compose, dịch vụ api dùng host db.
# Dùng 127.0.0.1, không dùng localhost: trên Windows localhost thử IPv6 (::1) trước, mà cổng chỉ mở trên
# 127.0.0.1 — mỗi kết nối mới sẽ chờ thêm 2–5 giây.
DATABASE_URL=postgresql+psycopg://fraud:fraud@127.0.0.1:5432/fraud

# Cơ sở dữ liệu dùng một lần cho pytest — tests/conftest.py tự tạo rồi xoá (docs/08 §1.1)
TEST_DATABASE_URL=postgresql+psycopg://fraud:fraud@127.0.0.1:5432/fraud_test
